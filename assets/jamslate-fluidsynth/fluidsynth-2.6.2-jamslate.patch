+#elif defined(JAMSLATE_STB_VORBIS)
+/* JamSlate: decode the Ogg Vorbis samples of an SF3 with stb_vorbis (public domain) instead of libsndfile, which is not available on Android.
+ * Same rounding to 16 bit as the libsndfile path above (NaN -> silence, clamp, round half to even). */
+#define STB_VORBIS_NO_STDIO 1
+#define STB_VORBIS_NO_PUSHDATA_API 1
+#include "stb_vorbis.c"
+
+static FLUID_INLINE short fluid_sf3_float_to_s16(float sample)
+{
+    if(isnan(sample))
+    {
+        return 0;
+    }
+
+    fluid_clip(sample, -1.0f, 32767.0f / 32768.0f);
+    return (short)lrintf(sample * 32768.0f);
+}
+
+static int fluid_sffile_read_vorbis(SFData *sf, unsigned int start_byte, unsigned int end_byte, short **data)
+{
+    unsigned char *comp;
+    size_t len;
+    int err = 0, frames, got = 0;
+    stb_vorbis *v;
+    stb_vorbis_info info;
+    short *wav;
+    float tmp[1024];
+
+    if((start_byte > sf->samplesize) || (end_byte > sf->samplesize))
+    {
+        FLUID_LOG(FLUID_ERR, "Ogg Vorbis data offsets exceed sample data chunk");
+        return -1;
+    }
+
+    len = (size_t)(end_byte + 1) - start_byte;      /* same extent as the libsndfile path */
+    comp = FLUID_MALLOC(len);
+
+    if(!comp)
+    {
+        FLUID_LOG(FLUID_PANIC, "Out of memory");
+        return -1;
+    }
+
+    fluid_rec_mutex_lock(sf->mtx);
+
+    if(sf->fcbs->fseek(sf->sffd, sf->samplepos + start_byte, SEEK_SET) == FLUID_FAILED ||
+            sf->fcbs->fread(comp, (int)len, sf->sffd) == FLUID_FAILED)
+    {
+        fluid_rec_mutex_unlock(sf->mtx);
+        FLUID_LOG(FLUID_ERR, "Failed to read compressed sample data");
+        FLUID_FREE(comp);
+        return -1;
+    }
+
+    fluid_rec_mutex_unlock(sf->mtx);
+
+    v = stb_vorbis_open_memory(comp, (int)len, &err, NULL);
+
+    if(!v)
+    {
+        FLUID_LOG(FLUID_ERR, "stb_vorbis could not open a compressed sample (error %d)", err);
+        FLUID_FREE(comp);
+        return -1;
+    }
+
+    info = stb_vorbis_get_info(v);
+    frames = (int)stb_vorbis_stream_length_in_samples(v);
+
+    if(frames <= 0)
+    {
+        stb_vorbis_close(v);
+        FLUID_FREE(comp);
+        *data = NULL;
+        return 0;
+    }
+
+    if(info.channels != 1)
+    {
+        FLUID_LOG(FLUID_DBG, "Unsupported channel count %d in ogg sample", info.channels);
+        stb_vorbis_close(v);
+        FLUID_FREE(comp);
+        return -1;
+    }
+
+    wav = FLUID_ARRAY(short, frames);
+
+    if(!wav)
+    {
+        FLUID_LOG(FLUID_PANIC, "Out of memory");
+        stb_vorbis_close(v);
+        FLUID_FREE(comp);
+        return -1;
+    }
+
+    while(got < frames)
+    {
+        int want = frames - got > 1024 ? 1024 : frames - got;
+        int n = stb_vorbis_get_samples_float_interleaved(v, 1, tmp, want);
+        int i;
+
+        if(n <= 0)
+        {
+            break;
+        }
+
+        for(i = 0; i < n; i++)
+        {
+            wav[got + i] = fluid_sf3_float_to_s16(tmp[i]);
+        }
+
+        got += n;
+    }
+
+    stb_vorbis_close(v);
+    FLUID_FREE(comp);
+
+    if(got < frames)
+    {
+        FLUID_LOG(FLUID_DBG, "Decompression failed!");
+        FLUID_FREE(wav);
+        return -1;
+    }
+
+    *data = wav;
+    return frames;
+}
 #else
 static int fluid_sffile_read_vorbis(SFData *sf, unsigned int start_byte, unsigned int end_byte, short **data)
 {
